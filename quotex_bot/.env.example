# Copy this file to .env and fill in your Quotex credentials.
# .env is gitignored — never commit it.
QUOTEX_EMAIL=your_quotex_email@example.com
QUOTEX_PASSWORD=your_quotex_password

# Optional: proxy for reaching Quotex (some ISPs block the domain at TLS level).
# Any HTTPS or SOCKS5 proxy works, e.g.:
# QUOTEX_PROXY=http://user:pass@host:port
# QUOTEX_PROXY=socks5://user:pass@host:port
# QUOTEX_PROXY=
